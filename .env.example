NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ADMIN_EMAIL=tolgar@sasmaz.digital
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=tolgar@sasmaz.digital
ADAPTIFAI_BACKEND_URL=http://127.0.0.1:8000
ADAPTIFAI_DEMO_CREDITS=240

# Keep real secrets in .env.local only. Never commit them.
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=gpt-5.6-terra
ADAPTIFAI_LOCALIZE_QA_MODEL=gpt-5.6-luna
ADAPTIFAI_LOCALIZE_ESCALATION_MODEL=gpt-5.6-sol
ADAPTIFAI_LOCALIZE_TRANSLATION_QA=1
ADAPTIFAI_OPENAI_REASONING_EFFORT=none
ADAPTIFAI_LOCALIZE_RENDERER=openai
ADAPTIFAI_OPENAI_IMAGE_MODEL=gpt-image-2
ADAPTIFAI_OPENAI_IMAGE_QUALITY=medium
ADAPTIFAI_SMART_REFRAME_ANALYSIS_PROVIDER=auto
ADAPTIFAI_SMART_REFRAME_ANALYSIS_MODEL=gpt-5.6-terra
ADAPTIFAI_SMART_REFRAME_ANALYSIS_MAX_SIDE=1600
ADAPTIFAI_SMART_REFRAME_ANALYSIS_TIMEOUT=35
VERTEX_GEMINI_MODEL=gemini-3.6-flash
ADAPTIFAI_RESIZE_AI_LAYOUT_PROVIDER=openai
ADAPTIFAI_RESIZE_AI_LAYOUT_MODEL=gpt-5.6-luna
ADAPTIFAI_RESIZE_AI_LAYOUT_TIMEOUT=20
ADAPTIFAI_ENABLE_OPENAI_OUTPAINT=1
ADAPTIFAI_ENABLE_VERTEX_OUTPAINT=1
ADAPTIFAI_ENABLE_RESIZE_ASPECT_FAMILY_OUTPAINT=1
REPLICATE_PRODUCT_CUTOUT_FALLBACK_MODELS=recraft-ai/recraft-remove-background,lucataco/remove-bg
GOOGLE_FONTS_API_KEY=

ADAPTIFAI_TROCR_MODEL=microsoft/trocr-base-printed
ADAPTIFAI_OCR_ENGINE=easyocr
ADAPTIFAI_INPAINT_BACKEND=stable-diffusion
ADAPTIFAI_ALLOW_CPU_STABLE_DIFFUSION=0
ADAPTIFAI_INPAINT_MODEL=runwayml/stable-diffusion-inpainting
ADAPTIFAI_INPAINT_MAX_SIDE=128
ADAPTIFAI_INPAINT_STEPS=4
ADAPTIFAI_RESIZE_STRATEGY=smart-reframe
ADAPTIFAI_DEBUG_STRATEGY_FILENAMES=0

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_DESTINATION_ID=
STRIPE_WEBHOOK_NAME=
